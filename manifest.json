{
  "manifest_version": 3,
  "name": "Ermes Stralcio Completo",
  "version": "1",
  "description": "Estrazione report piloti con riepilogo statistiche per scopo del volo + modulo Parti Prime (azioni rapide e allegato scansioni)",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "ico.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://ermes.cen.poliziadistato.it/*",
    "https://ermes.cen.poliziadistato.it/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://ermes.cen.poliziadistato.it/*"
      ],
      "js": [
        "stralcio.js"
      ]
    },
    {
      "matches": [
        "http://ermes.cen.poliziadistato.it/admin/parte-prima*",
        "https://ermes.cen.poliziadistato.it/admin/parte-prima*",
        "http://ermes.cen.poliziadistato.it/admin/index/add-allegati*",
        "https://ermes.cen.poliziadistato.it/admin/index/add-allegati*"
      ],
      "js": [
        "parteprima.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://ermes.cen.poliziadistato.it/*",
        "https://ermes.cen.poliziadistato.it/*"
      ],
      "js": [
        "login.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
