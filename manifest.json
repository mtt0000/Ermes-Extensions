{
  "manifest_version": 3,
  "name": "Ermes Stralcio Completo",
  "version": "2.1",
  "description": "Estrazione report piloti con riepilogo statistiche e data ultimo volo",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "ico.png"
  },
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://ermes.cen.poliziadistato.it/*"],
      "js": ["content.js"]
    }
  ]
}
